{
  "name": "devstarter",
  "displayName": "DevStarter",
  "description": "",
  "version": "0.0.1",

  "packageManager": "pnpm@10",

  "engines": {
    "vscode": "^1.105.0"
  },

  "categories": [
    "Other"
  ],

  "activationEvents": [
    "onCommand:devstarter.StartProyect"
  ],

  "main": "./dist/extension.js",

  "contributes": {
    "commands": [
      {
        "command": "devstarter.StartProyect",
        "title": "Start Proyect"
      }
    ]
  },

  "license": "LICENSE.txt",

  "scripts": {
    "vscode:prepublish": "pnpm package",

    "compile": "pnpm check-types && pnpm lint && node esbuild.js",

    "watch": "pnpm --parallel watch:esbuild watch:tsc",

    "watch:esbuild": "node esbuild.js --watch",

    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",

    "package": "pnpm check-types && pnpm lint && node esbuild.js --production",

    "compile-tests": "tsc -p . --outDir out",

    "watch-tests": "tsc -p . -w --outDir out",

    "pretest": "pnpm compile-tests && pnpm compile && pnpm lint",

    "check-types": "tsc --noEmit",

    "lint": "eslint src",

    "test": "vscode-test"
  },

  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },

  "dependencies": {
    "inquirer": "^13.0.1"
  }
}