// Tareas de VS Code (Terminal > Ejecutar tarea...).
//
// ── PUBLICAR (Microsoft Marketplace + Open VSX de una vez) ──────────────────────────────
//  "DevStarter: Publish (ensayo)"            comprueba y empaqueta, sin publicar nada
//  "DevStarter: Publish everywhere"          publica en las dos tiendas pidiendo los tokens
//  "DevStarter: Publish everywhere (fast)"   igual, sin ejecutar los tests
//  "DevStarter: Publish (tokens del sistema)" usa las variables VSCE_PAT y OVSX_PAT ya guardadas
//
// Los tokens se piden en un cuadro (con la escritura oculta) y solo se pasan a ese proceso:
// no se guardan en ningun fichero. Para guardarlos tu mismo, define las variables de usuario
// VSCE_PAT y OVSX_PAT y usa la ultima tarea.
{
	"version": "2.0.0",
	"tasks": [
		{
            "label": "watch",
            "dependsOn": [
                "npm: watch:tsc",
                "npm: watch:esbuild"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "watch:esbuild",
            "group": "build",
            "problemMatcher": "$esbuild-watch",
            "isBackground": true,
            "label": "npm: watch:esbuild",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
		{
            "type": "npm",
            "script": "watch:tsc",
            "group": "build",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "npm: watch:tsc",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
		{
			"type": "npm",
			"script": "watch-tests",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": [
				"npm: watch",
				"npm: watch-tests"
			],
			"problemMatcher": []
		},

		// ── Publicar ────────────────────────────────────────────────────────────────
		{
			"label": "DevStarter: Publish (ensayo)",
			"detail": "Comprueba todo y crea el .vsix, pero NO publica nada",
			"type": "shell",
			"command": "pnpm publish:check",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true }
		},
		{
			"label": "DevStarter: Publish everywhere",
			"detail": "Marketplace de Microsoft + Open VSX (Cursor, Windsurf, VSCodium...) con comprobaciones completas",
			"type": "shell",
			"command": "pnpm publish:all",
			"options": {
				"env": {
					"VSCE_PAT": "${input:vsceToken}",
					"OVSX_PAT": "${input:ovsxToken}"
				}
			},
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true }
		},
		{
			"label": "DevStarter: Publish everywhere (fast)",
			"detail": "Igual que la anterior pero sin ejecutar los tests (tipos, lint y formato si se ejecutan)",
			"type": "shell",
			"command": "pnpm publish:all --skip-tests",
			"options": {
				"env": {
					"VSCE_PAT": "${input:vsceToken}",
					"OVSX_PAT": "${input:ovsxToken}"
				}
			},
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true }
		},
		{
			"label": "DevStarter: Publish (tokens del sistema)",
			"detail": "Usa las variables de entorno VSCE_PAT y OVSX_PAT que ya tengas guardadas",
			"type": "shell",
			"command": "pnpm publish:all",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true }
		},
		{
			"label": "DevStarter: Package .vsix",
			"detail": "Crea el paquete .vsix para instalarlo a mano",
			"type": "shell",
			"command": "pnpm package:vsix",
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "vsceToken",
			"type": "promptString",
			"description": "Token del Marketplace de Microsoft (Azure DevOps, permiso Marketplace > Manage). No se guarda.",
			"password": true
		},
		{
			"id": "ovsxToken",
			"type": "promptString",
			"description": "Token de Open VSX (open-vsx.org > Access Tokens). No se guarda.",
			"password": true
		}
	]
}
